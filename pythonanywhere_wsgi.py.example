"""Template for the WSGI file configured on PythonAnywhere's Web tab."""

import os
import sys

PROJECT_PATH = "/home/YOUR_USERNAME/carteira-da-turma-django"
if PROJECT_PATH not in sys.path:
    sys.path.insert(0, PROJECT_PATH)

os.environ["DJANGO_SETTINGS_MODULE"] = "config.settings"
os.environ["DEBUG"] = "False"
os.environ["SECRET_KEY"] = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
os.environ["ALLOWED_HOSTS"] = "YOUR_USERNAME.pythonanywhere.com"
os.environ["CSRF_TRUSTED_ORIGINS"] = "https://YOUR_USERNAME.pythonanywhere.com"
os.environ["SQLITE_PATH"] = f"{PROJECT_PATH}/db.sqlite3"
# Enable HTTPS redirection on PythonAnywhere's Web tab.
os.environ["SECURE_SSL_REDIRECT"] = "False"
os.environ["SECURE_HSTS_SECONDS"] = "3600"

from django.core.wsgi import get_wsgi_application

application = get_wsgi_application()
